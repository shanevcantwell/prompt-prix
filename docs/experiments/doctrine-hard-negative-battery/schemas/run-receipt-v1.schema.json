{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shanevcantwell/prompt-prix/docs/experiments/doctrine-hard-negative-battery/schemas/run-receipt-v1.schema.json",
  "title": "Doctrine hard-negative battery run receipt v1 (proposal)",
  "description": "Proposal-only per-run receipt contract with mutually exclusive NOT_RUN, COMPLETED, PENDING_ADJUDICATION, and INFRASTRUCTURE_ERROR states. NOT_RUN plan receipts must not be presented as observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_version",
    "receipt_id",
    "record_kind",
    "execution_state",
    "package_identity",
    "cell",
    "model",
    "provider",
    "payload",
    "tools",
    "seed",
    "sampling",
    "context",
    "trace",
    "predicate",
    "human_adjudication",
    "judge",
    "attempts",
    "usage_cost",
    "privacy",
    "disposition",
    "timestamps"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0-proposal"},
    "receipt_version": {"const": "1.0.0-proposal"},
    "receipt_id": {"type": "string", "minLength": 1},
    "record_kind": {"enum": ["dry_run_plan", "run_receipt"]},
    "execution_state": {"enum": ["NOT_RUN", "COMPLETED", "PENDING_ADJUDICATION", "INFRASTRUCTURE_ERROR"]},
    "package_identity": {"$ref": "#/$defs/package_identity"},
    "cell": {"$ref": "#/$defs/cell"},
    "model": {"$ref": "#/$defs/model"},
    "provider": {"$ref": "#/$defs/provider"},
    "payload": {"$ref": "#/$defs/payload"},
    "tools": {"$ref": "#/$defs/tools"},
    "seed": {"$ref": "#/$defs/seed"},
    "sampling": {"$ref": "#/$defs/sampling"},
    "context": {"$ref": "#/$defs/context"},
    "trace": {"$ref": "#/$defs/trace"},
    "predicate": {"$ref": "#/$defs/predicate"},
    "human_adjudication": {"$ref": "#/$defs/human_adjudication"},
    "judge": {"$ref": "#/$defs/judge"},
    "attempts": {
      "type": "array",
      "items": {"$ref": "#/$defs/attempt"}
    },
    "usage_cost": {"$ref": "#/$defs/usage_cost"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "disposition": {"$ref": "#/$defs/disposition"},
    "timestamps": {"$ref": "#/$defs/timestamps"}
  },
  "oneOf": [
    {
      "title": "NOT_RUN dry-run plan",
      "properties": {
        "record_kind": {"const": "dry_run_plan"},
        "execution_state": {"const": "NOT_RUN"},
        "payload": {
          "properties": {"normalized_response": {"$ref": "#/$defs/no_normalized_response"}},
          "required": ["normalized_response"]
        },
        "trace": {
          "properties": {
            "complete": {"const": false},
            "native_trace_sha256": {"type": "null"},
            "normalized_trace_sha256": {"type": "null"},
            "events": {"maxItems": 0}
          },
          "required": ["complete", "native_trace_sha256", "normalized_trace_sha256", "events"]
        },
        "predicate": {
          "properties": {"verdict": {"const": "not_evaluated"}},
          "required": ["verdict"]
        },
        "judge": {
          "properties": {"enabled": {"const": false}},
          "required": ["enabled"]
        },
        "attempts": {"maxItems": 0},
        "disposition": {
          "properties": {"primary_lane": {"const": "NOT_ASSIGNED"}},
          "required": ["primary_lane"]
        },
        "timestamps": {
          "properties": {
            "started_at": {"type": "null"},
            "completed_at": {"type": "null"}
          },
          "required": ["started_at", "completed_at"]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "predicate": {
                  "properties": {"kind": {"enum": ["direct_route_v1", "delegate_route_v1", "workflow_route_v1"]}},
                  "required": ["kind"]
                },
                "human_adjudication": {"$ref": "#/$defs/not_required_human_adjudication"}
              }
            },
            {
              "properties": {
                "predicate": {
                  "properties": {"kind": {"const": "none"}},
                  "required": ["kind"]
                },
                "human_adjudication": {"$ref": "#/$defs/pending_human_adjudication"}
              }
            }
          ]
        }
      ]
    },
    {
      "title": "COMPLETED terminal semantic receipt",
      "properties": {
        "record_kind": {"const": "run_receipt"},
        "execution_state": {"const": "COMPLETED"},
        "payload": {
          "properties": {"normalized_response": {"$ref": "#/$defs/retained_normalized_response"}},
          "required": ["normalized_response"]
        },
        "trace": {
          "properties": {
            "complete": {"const": true},
            "native_trace_sha256": {"$ref": "#/$defs/sha256"},
            "normalized_trace_sha256": {"$ref": "#/$defs/sha256"}
          },
          "required": ["complete", "native_trace_sha256", "normalized_trace_sha256"]
        },
        "attempts": {
          "minItems": 1,
          "contains": {
            "type": "object",
            "properties": {"state": {"const": "completed"}},
            "required": ["state"]
          },
          "minContains": 1
        },
        "disposition": {
          "properties": {
            "primary_lane": {
              "enum": [
                "HARNESS_DIRECTIVE_ABSENT",
                "DOCTRINE_AMBIGUOUS",
                "BATTERY_DEFECT",
                "CAPABILITY_TOOLING_LIMIT",
                "TRAINING_CALIBRATION_CANDIDATE",
                "LOCAL_FLOOR_HARNESS_GAP",
                "CANDIDATE_BASELINE"
              ]
            },
            "evidence_refs": {"minItems": 1}
          },
          "required": ["primary_lane", "evidence_refs"]
        },
        "timestamps": {
          "properties": {
            "started_at": {"type": "string", "format": "date-time"},
            "completed_at": {"type": "string", "format": "date-time"}
          },
          "required": ["started_at", "completed_at"]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "predicate": {
                  "properties": {
                    "kind": {"enum": ["direct_route_v1", "delegate_route_v1", "workflow_route_v1"]},
                    "verdict": {"enum": ["pass", "fail"]}
                  },
                  "required": ["kind", "verdict"]
                },
                "human_adjudication": {"$ref": "#/$defs/not_required_human_adjudication"}
              }
            },
            {
              "properties": {
                "predicate": {
                  "properties": {"kind": {"const": "none"}, "verdict": {"const": "pass"}},
                  "required": ["kind", "verdict"]
                },
                "human_adjudication": {"$ref": "#/$defs/passing_human_adjudication"}
              }
            },
            {
              "properties": {
                "predicate": {
                  "properties": {"kind": {"const": "none"}, "verdict": {"const": "fail"}},
                  "required": ["kind", "verdict"]
                },
                "human_adjudication": {"$ref": "#/$defs/failing_human_adjudication"}
              }
            }
          ]
        }
      ]
    },
    {
      "title": "PENDING_ADJUDICATION non-terminal emergent receipt",
      "properties": {
        "record_kind": {"const": "run_receipt"},
        "execution_state": {"const": "PENDING_ADJUDICATION"},
        "payload": {
          "properties": {"normalized_response": {"$ref": "#/$defs/retained_normalized_response"}},
          "required": ["normalized_response"]
        },
        "trace": {
          "properties": {
            "complete": {"const": true},
            "native_trace_sha256": {"$ref": "#/$defs/sha256"},
            "normalized_trace_sha256": {"$ref": "#/$defs/sha256"}
          },
          "required": ["complete", "native_trace_sha256", "normalized_trace_sha256"]
        },
        "predicate": {
          "properties": {"kind": {"const": "none"}, "verdict": {"const": "not_evaluated"}},
          "required": ["kind", "verdict"]
        },
        "human_adjudication": {"$ref": "#/$defs/pending_human_adjudication"},
        "attempts": {
          "minItems": 1,
          "contains": {
            "type": "object",
            "properties": {"state": {"const": "completed"}},
            "required": ["state"]
          },
          "minContains": 1
        },
        "disposition": {
          "properties": {"primary_lane": {"const": "NOT_ASSIGNED"}},
          "required": ["primary_lane"]
        },
        "timestamps": {
          "properties": {
            "started_at": {"type": "string", "format": "date-time"},
            "completed_at": {"type": "null"}
          },
          "required": ["started_at", "completed_at"]
        }
      }
    },
    {
      "title": "INFRASTRUCTURE_ERROR terminal receipt",
      "properties": {
        "record_kind": {"const": "run_receipt"},
        "execution_state": {"const": "INFRASTRUCTURE_ERROR"},
        "trace": {
          "properties": {"complete": {"const": false}},
          "required": ["complete"]
        },
        "predicate": {
          "properties": {"verdict": {"const": "infrastructure_error"}},
          "required": ["verdict"]
        },
        "human_adjudication": {
          "oneOf": [
            {"$ref": "#/$defs/not_required_human_adjudication"},
            {"$ref": "#/$defs/pending_human_adjudication"}
          ]
        },
        "judge": {
          "properties": {"enabled": {"const": false}},
          "required": ["enabled"]
        },
        "attempts": {
          "minItems": 1,
          "contains": {
            "type": "object",
            "properties": {"state": {"const": "infrastructure_error"}},
            "required": ["state"]
          },
          "minContains": 1,
          "not": {
            "contains": {
              "type": "object",
              "properties": {"state": {"const": "completed"}},
              "required": ["state"]
            }
          }
        },
        "disposition": {
          "properties": {"primary_lane": {"const": "INCONCLUSIVE_INFRASTRUCTURE"}},
          "required": ["primary_lane"]
        },
        "timestamps": {
          "properties": {
            "started_at": {"type": "string", "format": "date-time"},
            "completed_at": {"type": "string", "format": "date-time"}
          },
          "required": ["started_at", "completed_at"]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "no_normalized_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "media_type", "sha256", "text", "artifact_uri"],
      "properties": {
        "kind": {"const": "none"},
        "media_type": {"type": "null"},
        "sha256": {"type": "null"},
        "text": {"type": "null"},
        "artifact_uri": {"type": "null"}
      }
    },
    "inline_normalized_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "media_type", "sha256", "text", "artifact_uri"],
      "properties": {
        "kind": {"const": "inline"},
        "media_type": {"const": "text/plain; charset=utf-8"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string", "minLength": 1},
        "artifact_uri": {"type": "null"}
      }
    },
    "artifact_normalized_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "media_type", "sha256", "text", "artifact_uri"],
      "properties": {
        "kind": {"const": "artifact"},
        "media_type": {"const": "text/plain; charset=utf-8"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "text": {"type": "null"},
        "artifact_uri": {
          "type": "string",
          "pattern": "^(sha256:|file:|https://).+$"
        }
      }
    },
    "retained_normalized_response": {
      "oneOf": [
        {"$ref": "#/$defs/inline_normalized_response"},
        {"$ref": "#/$defs/artifact_normalized_response"}
      ]
    },
    "normalized_response": {
      "oneOf": [
        {"$ref": "#/$defs/no_normalized_response"},
        {"$ref": "#/$defs/retained_normalized_response"}
      ]
    },
    "module_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_name", "version", "sha256", "order"],
      "properties": {
        "logical_name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "order": {"type": "integer", "minimum": 0}
      }
    },
    "package_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_version", "package_sha256", "case_version", "variant_version"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "case_version": {"type": "string", "minLength": 1},
        "variant_version": {"type": "string", "minLength": 1}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_receipt_id", "execution_profile_id", "variant_id", "case_id", "scale", "repetition_index"],
      "properties": {
        "model_receipt_id": {"type": "string", "minLength": 1},
        "execution_profile_id": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "scale": {"enum": ["micro", "section", "full_payload"]},
        "repetition_index": {"type": "integer", "minimum": 0}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "artifact", "revision_or_digest", "quantization"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "revision_or_digest": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "adapter", "api_shape", "endpoint_class", "seed_support"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "api_shape": {"type": "string", "minLength": 1},
        "endpoint_class": {"type": "string", "minLength": 1},
        "seed_support": {"enum": ["supported", "unsupported", "unknown"]}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "assembled_prompt_sha256",
        "task_payload_sha256",
        "normalized_response",
        "modules"
      ],
      "properties": {
        "canonicalization": {"const": "utf8-lf-no-unicode-normalization-rfc8785-v1"},
        "assembled_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "task_payload_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_response": {"$ref": "#/$defs/normalized_response"},
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/module_identity"}
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_schema_sha256", "active_tool_set"],
      "properties": {
        "tool_schema_sha256": {"$ref": "#/$defs/sha256"},
        "active_tool_set": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master_seed",
        "derivation",
        "derivation_inputs",
        "requested_seed",
        "effective_seed",
        "sample_id"
      ],
      "properties": {
        "master_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "derivation": {"const": "sha256-jcs-array-first-31-bits-v1"},
        "derivation_inputs": {
          "type": "array",
          "prefixItems": [
            {"type": "string"},
            {"type": "string"},
            {"type": "string"},
            {"type": "string"},
            {"type": "string"},
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0, "maximum": 2147483647}
          ],
          "items": false
        },
        "requested_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "effective_seed": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 2147483647},
            {"type": "null"}
          ]
        },
        "sample_id": {"type": "string", "minLength": 1}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": true,
      "required": ["temperature", "max_tokens", "effort", "thinking_mode", "public_thinking_observed"],
      "properties": {
        "temperature": {"type": "number"},
        "max_tokens": {"type": "integer", "minimum": 1},
        "effort": {"type": "string", "minLength": 1},
        "thinking_mode": {"type": "string", "minLength": 1},
        "public_thinking_observed": {"enum": ["present", "not_observed", "not_applicable", "unknown"]}
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_or_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version_or_digest": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cwd_logical", "project_id", "repository_commit", "worktree_dirty", "extensions"],
      "properties": {
        "cwd_logical": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "repository_commit": {"type": "string", "minLength": 1},
        "worktree_dirty": {"type": "boolean"},
        "extensions": {
          "type": "array",
          "items": {"$ref": "#/$defs/extension"}
        }
      }
    },
    "trace_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_type",
        "actor",
        "tool_name",
        "arguments",
        "success",
        "source_surface",
        "monotonic_timestamp"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "event_type": {"enum": ["tool_call", "tool_result", "assistant_output", "human_reminder", "inline_work", "termination"]},
        "actor": {"type": "string", "minLength": 1},
        "tool_name": {"type": ["string", "null"]},
        "arguments": {"type": "object"},
        "success": {"type": ["boolean", "null"]},
        "source_surface": {"type": "string", "minLength": 1},
        "monotonic_timestamp": {"type": "number", "minimum": 0}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "native_trace_sha256", "normalized_trace_sha256", "events", "deterministic_facts"],
      "properties": {
        "complete": {"type": "boolean"},
        "native_trace_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "normalized_trace_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/trace_event"}
        },
        "deterministic_facts": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate_version", "kind", "verdict", "reason_codes"],
      "properties": {
        "predicate_version": {"const": "1.0.0-proposal"},
        "kind": {"enum": ["direct_route_v1", "delegate_route_v1", "workflow_route_v1", "none"]},
        "verdict": {"enum": ["pass", "fail", "not_applicable", "not_evaluated", "infrastructure_error"]},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_text", "start_char", "end_char"],
      "properties": {
        "exact_text": {"type": "string", "minLength": 1},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1}
      }
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "adjudication_procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure_id", "version", "sha256"],
      "properties": {
        "procedure_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "not_required_human_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "adjudicator", "procedure", "blinded", "verdict", "evidence_spans", "expectations_match", "adjudicated_at"],
      "properties": {
        "status": {"const": "not_required"},
        "adjudicator": {"type": "null"},
        "procedure": {"type": "null"},
        "blinded": {"type": "null"},
        "verdict": {"type": "null"},
        "evidence_spans": {"type": "array", "maxItems": 0},
        "expectations_match": {"type": "null"},
        "adjudicated_at": {"type": "null"}
      }
    },
    "pending_human_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "adjudicator", "procedure", "blinded", "verdict", "evidence_spans", "expectations_match", "adjudicated_at"],
      "properties": {
        "status": {"const": "pending"},
        "adjudicator": {"$ref": "#/$defs/adjudicator"},
        "procedure": {"$ref": "#/$defs/adjudication_procedure"},
        "blinded": {"type": "boolean"},
        "verdict": {"type": "null"},
        "evidence_spans": {"type": "array", "maxItems": 0},
        "expectations_match": {"type": "null"},
        "adjudicated_at": {"type": "null"}
      }
    },
    "completed_human_adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "adjudicator", "procedure", "blinded", "verdict", "evidence_spans", "expectations_match", "adjudicated_at"],
      "properties": {
        "status": {"const": "completed"},
        "adjudicator": {"$ref": "#/$defs/adjudicator"},
        "procedure": {"$ref": "#/$defs/adjudication_procedure"},
        "blinded": {"type": "boolean"},
        "verdict": {"enum": ["pass", "fail"]},
        "evidence_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence_span"}
        },
        "expectations_match": {"type": "boolean"},
        "adjudicated_at": {"type": "string", "format": "date-time"}
      }
    },
    "passing_human_adjudication": {
      "allOf": [
        {"$ref": "#/$defs/completed_human_adjudication"},
        {
          "properties": {
            "blinded": {"const": true},
            "verdict": {"const": "pass"},
            "expectations_match": {"const": true}
          },
          "required": ["blinded", "verdict", "expectations_match"]
        }
      ]
    },
    "failing_human_adjudication": {
      "allOf": [
        {"$ref": "#/$defs/completed_human_adjudication"},
        {
          "properties": {
            "blinded": {"const": true},
            "verdict": {"const": "fail"},
            "expectations_match": {"const": false}
          },
          "required": ["blinded", "verdict", "expectations_match"]
        }
      ]
    },
    "human_adjudication": {
      "oneOf": [
        {"$ref": "#/$defs/not_required_human_adjudication"},
