            "sole_gate_authority": {"const": false},
            "model": {"type": "null"},
            "provider": {"type": "null"},
            "prompt": {"type": "null"},
            "seed": {"type": "null"},
            "sampling": {"type": "null"},
            "latency_ms": {"type": "null"},
            "error": {"type": "null"},
            "output_sha256": {"type": "null"},
            "output": {"type": "null"}
          }
        },
