            "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
            "sampling": {"$ref": "#/$defs/judge_sampling"},
            "latency_ms": {"type": ["number", "null"], "minimum": 0},
            "error": {"type": "string", "minLength": 1},
            "output_sha256": {"type": "null"},
            "output": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "sole_gate_authority", "model", "provider", "prompt", "seed", "sampling", "latency_ms", "error", "output_sha256", "output"],
          "properties": {
            "enabled": {"const": true},
            "sole_gate_authority": {"const": false},
            "model": {"$ref": "#/$defs/judge_model"},
            "provider": {"$ref": "#/$defs/judge_provider"},
            "prompt": {"$ref": "#/$defs/judge_prompt"},
            "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
            "sampling": {"$ref": "#/$defs/judge_sampling"},
            "latency_ms": {"type": "number", "minimum": 0},
            "error": {"type": "null"},
            "output_sha256": {"$ref": "#/$defs/sha256"},
            "output": {"$ref": "#/$defs/judge_output"}
          }
        }
      ]
    },
    "attempt": {
      "oneOf": [
        {
          "type": "object",
