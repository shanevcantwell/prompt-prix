            "latency_ms": {"type": "number", "minimum": 0},
            "error_class": {"type": "null"},
            "error_message": {"type": "null"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt_index", "same_seed", "state", "started_at", "ended_at", "latency_ms", "error_class", "error_message"],
          "properties": {
            "attempt_index": {"type": "integer", "minimum": 0},
            "same_seed": {"const": true},
            "state": {"const": "infrastructure_error"},
            "started_at": {"type": "string", "format": "date-time"},
            "ended_at": {"type": "string", "format": "date-time"},
            "latency_ms": {"type": "number", "minimum": 0},
            "error_class": {"type": "string", "minLength": 1},
            "error_message": {"type": "string", "minLength": 1}
          }
